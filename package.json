{
  "name": "token-lens",
  "version": "0.2.0",
  "description": "Local-only dashboard for AI coding sessions. Track turns, tokens, cost across Cursor, Claude Code, and OpenCode. All data stays on your machine.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/FreePeak/token-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreePeak/token-lens.git"
  },
  "bugs": {
    "url": "https://github.com/FreePeak/token-lens/issues"
  },
  "keywords": [
    "cursor",
    "claude-code",
    "opencode",
    "ai-coding",
    "token-tracking",
    "llm-cost",
    "development-tool",
    "metrics",
    "dashboard"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "token-lens": "./src/cli.ts"
  },
  "scripts": {
    "backfill": "bun run src/cli.ts backfill",
    "backfill:incremental": "bun run src/cli.ts backfill --incremental",
    "sync-usage": "bun run src/cli.ts sync-usage",
    "recompute": "bun run src/cli.ts recompute",
    "cron:install": "bun run src/cli.ts cron install",
    "cron:uninstall": "bun run src/cli.ts cron uninstall",
    "cron:status": "bun run src/cli.ts cron status",
    "serve": "bun run src/cli.ts serve",
    "hook": "bun run src/cli.ts hook",
    "install-hooks": "bun run src/cli.ts install-hooks",
    "dashboard:dev": "cd dashboard && bun run dev",
    "dashboard:build": "cd dashboard && bun run build",
    "dashboard:install": "cd dashboard && bun install",
    "analyze": "bun run src/analyze.ts",
    "analyze:claude": "bun run src/analyze.ts --claude",
    "analyze:html": "bun run src/analyze.ts --html",
    "analyze:compact": "bun run src/analyze.ts --compact",
    "prices:fetch": "bun run scripts/fetch-prices.ts",
    "prices:sync": "bun run scripts/fetch-prices.ts --apply",
    "dev": "bun run src/cli.ts serve"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
